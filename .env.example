# Copy to .env.local and fill in from Supabase → Project Settings → API.
# These are PUBLIC values (safe in the browser). Never put the service_role key here.
# Project URL only, e.g. https://abcd1234.supabase.co (no /rest/v1 or other path)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
